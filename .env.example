# GEMINI_API_KEY: Required for Gemini AI API calls (AI Chatbot, TTS, Cover Generator, News Recommendation).
# Set this in AI Studio Secrets and/or Cloudflare Pages -> Settings -> Environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://pr-sai-thailand.pages.dev).
APP_URL="MY_APP_URL"

# Optional for sending real broadcast emails from Cloudflare Pages Functions:
# Configure either RESEND_API_KEY or EMAIL_WEBHOOK_URL in Cloudflare Pages Environment variables.
RESEND_API_KEY=""
EMAIL_WEBHOOK_URL=""
EMAIL_FROM=""
EMAIL_FROM_NAME="สำนักประชาสัมพันธ์และสื่อสารองค์กร สตง. (PR SAI Thailand)"
