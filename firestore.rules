rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'auditpicture.webapp@gmail.com' ||
          request.auth.token.email == 'jakwil@jakwil.page'
        );
    }

    function isValidHeroStory(data) {
      return data.keys().hasAll(['id', 'title', 'subtitle', 'category', 'imageUrl', 'linkUrl', 'date', 'order']) &&
             data.keys().hasOnly(['id', 'title', 'subtitle', 'category', 'imageUrl', 'linkUrl', 'date', 'badge', 'mediaType', 'order', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.subtitle is string && data.subtitle.size() <= 1000 &&
             data.category is string && data.category.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 700000 &&
             data.linkUrl is string && data.linkUrl.size() <= 1000 &&
             data.date is string && data.date.size() <= 50 &&
             data.order is number &&
             (!('badge' in data) || (data.badge is string && data.badge.size() <= 100)) &&
             (!('mediaType' in data) || data.mediaType in ['photo', 'infographic', 'video', 'report']) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidKnowledgeItem(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'content', 'sourceType', 'dateAdded']) &&
             data.keys().hasOnly(['id', 'title', 'category', 'content', 'sourceType', 'sourceUrl', 'dateAdded', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.category is string && data.category.size() <= 100 &&
             data.content is string && data.content.size() <= 10000 &&
             data.sourceType in ['url', 'raw_text', 'pdf_summary', 'infographic'] &&
             data.dateAdded is string && data.dateAdded.size() <= 50 &&
             (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 1000)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidPublishedWork(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'description', 'linkUrl', 'imageUrl', 'publishDate', 'views']) &&
             data.keys().hasOnly(['id', 'title', 'category', 'description', 'linkUrl', 'imageUrl', 'publishDate', 'views', 'badge', 'mediaType', 'videoUrl', 'resolution', 'duration', 'creator', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.category is string && data.category.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.linkUrl is string && data.linkUrl.size() <= 1000 &&
             data.imageUrl is string && data.imageUrl.size() <= 700000 &&
             data.publishDate is string && data.publishDate.size() <= 50 &&
             data.views is string && data.views.size() <= 50 &&
             (!('badge' in data) || (data.badge is string && data.badge.size() <= 100)) &&
             (!('mediaType' in data) || data.mediaType in ['photo', 'infographic', 'video', 'report']) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 1000)) &&
             (!('resolution' in data) || data.resolution in ['16:9', '9:16', '1:1', '4:3', '21:9']) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() <= 50)) &&
             (!('creator' in data) || (data.creator is string && data.creator.size() <= 150)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidViralClip(data) {
      return data.keys().hasAll(['id', 'title', 'creator', 'views', 'duration', 'thumbnail', 'linkUrl', 'highlight']) &&
             data.keys().hasOnly(['id', 'title', 'creator', 'views', 'duration', 'thumbnail', 'linkUrl', 'highlight', 'mediaType', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.creator is string && data.creator.size() <= 150 &&
             data.views is string && data.views.size() <= 50 &&
             data.duration is string && data.duration.size() <= 30 &&
             data.thumbnail is string && data.thumbnail.size() <= 700000 &&
             data.linkUrl is string && data.linkUrl.size() <= 1000 &&
             data.highlight is string && data.highlight.size() <= 500 &&
             (!('mediaType' in data) || data.mediaType in ['video', 'motion_graphic', 'short']) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidIncidentMilestone(data) {
      return data.keys().hasAll(['id', 'date', 'time', 'phase', 'title', 'description', 'status', 'imageUrl', 'technicalDetails']) &&
             data.keys().hasOnly(['id', 'date', 'time', 'phase', 'title', 'description', 'status', 'imageUrl', 'technicalDetails', 'shortTitle', 'fullStatement', 'mediaType', 'videoUrl', 'referenceTitle', 'referenceUrl', 'colorAccent', 'icon', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.date is string && data.date.size() <= 50 &&
             data.time is string && data.time.size() <= 30 &&
             data.phase is string && data.phase.size() <= 100 &&
             data.title is string && data.title.size() <= 300 &&
             data.description is string && data.description.size() <= 2000 &&
             data.status is string && data.status.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 700000 &&
             data.technicalDetails is string && data.technicalDetails.size() <= 2000 &&
             (!('shortTitle' in data) || (data.shortTitle is string && data.shortTitle.size() <= 150)) &&
             (!('fullStatement' in data) || (data.fullStatement is string && data.fullStatement.size() <= 10000)) &&
             (!('mediaType' in data) || data.mediaType in ['photo', 'video']) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 1000)) &&
             (!('referenceTitle' in data) || (data.referenceTitle is string && data.referenceTitle.size() <= 300)) &&
             (!('referenceUrl' in data) || (data.referenceUrl is string && data.referenceUrl.size() <= 1000)) &&
             (!('colorAccent' in data) || (data.colorAccent is string && data.colorAccent.size() <= 50)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidMusicSettings(data) {
      return data.keys().hasAll(['driveUrl', 'defaultVolume', 'duckingVolume', 'enabled']) &&
             data.keys().hasOnly(['driveUrl', 'streamUrl', 'title', 'defaultVolume', 'duckingVolume', 'enabled', 'updatedAt']) &&
             data.driveUrl is string && data.driveUrl.size() <= 1000 &&
             data.defaultVolume is number && data.defaultVolume >= 0 && data.defaultVolume <= 1 &&
             data.duckingVolume is number && data.duckingVolume >= 0 && data.duckingVolume <= 1 &&
             data.enabled is bool;
    }

    function isValidChatbotSettings(data) {
      return data.keys().hasAll(['enabled']) &&
             data.keys().hasOnly(['enabled', 'autoOpen', 'welcomeMessage', 'updatedAt']) &&
             data.enabled is bool &&
             (!('autoOpen' in data) || data.autoOpen is bool) &&
             (!('welcomeMessage' in data) || (data.welcomeMessage is string && data.welcomeMessage.size() <= 2000)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidMarqueeTicker(data) {
      return data.keys().hasAll(['enabled', 'direction', 'speedSeconds', 'pauseOnHover', 'messages']) &&
             data.keys().hasOnly(['enabled', 'direction', 'speedSeconds', 'pauseOnHover', 'prefixLabel', 'messages', 'updatedAt']) &&
             data.enabled is bool &&
             data.direction in ['left-to-right', 'right-to-left'] &&
             data.speedSeconds is number && data.speedSeconds >= 5 && data.speedSeconds <= 300 &&
             data.pauseOnHover is bool &&
             data.messages is list && data.messages.size() <= 50 &&
             (!('prefixLabel' in data) || (data.prefixLabel is string && data.prefixLabel.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidNewsSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'storyId', 'storyTitle', 'subscribedAt']) &&
             data.keys().hasOnly(['id', 'email', 'storyId', 'storyTitle', 'category', 'subscribedAt', 'active', 'tags', 'lastNotifiedAt', 'notifyCount', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.storyId is string && data.storyId.size() <= 128 &&
             data.storyTitle is string && data.storyTitle.size() <= 300 &&
             data.subscribedAt is string && data.subscribedAt.size() <= 60 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10));
    }

    function isValidNewsBroadcast(data) {
      return data.keys().hasAll(['id', 'storyId', 'storyTitle', 'subject', 'sentAt', 'recipientCount']) &&
             data.keys().hasOnly(['id', 'storyId', 'storyTitle', 'subject', 'summary', 'recipientCount', 'recipients', 'aiGenerated', 'sentAt', 'deliveryStatus', 'deliveredEmails', 'failedEmails', 'errorMessage', 'previewUrl', 'smtpUser']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.storyId is string && data.storyId.size() <= 128 &&
             data.subject is string && data.subject.size() <= 300 &&
             (!('recipients' in data) || (data.recipients is list && data.recipients.size() <= 500));
    }

    function isValidVisitorLog(data) {
      return data.keys().hasAll(['timestamp', 'action']) &&
             data.keys().hasOnly(['timestamp', 'action', 'page', 'userAgent']) &&
             data.timestamp is string && data.timestamp.size() <= 50 &&
             data.action is string && data.action.size() <= 100 &&
             (!('page' in data) || (data.page is string && data.page.size() <= 100)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 500));
    }

    // Hero Stories Collection
    match /heroStories/{storyId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(storyId) && isValidHeroStory(incoming());
      allow delete: if isAdmin() && isValidId(storyId);
    }

    // Knowledge Base Collection
    match /knowledgeBase/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(itemId) && isValidKnowledgeItem(incoming());
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // Published Works Collection
    match /publishedWorks/{workId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(workId) && isValidPublishedWork(incoming());
      allow delete: if isAdmin() && isValidId(workId);
    }

    // Viral Clips Collection
    match /viralClips/{clipId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(clipId) && isValidViralClip(incoming());
      allow delete: if isAdmin() && isValidId(clipId);
    }

    // Incident Timeline Collection
    match /incidentTimeline/{milestoneId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(milestoneId) && isValidIncidentMilestone(incoming());
      allow delete: if isAdmin() && isValidId(milestoneId);
    }

    // News Subscribers Collection (PII isolated to Admin for read/update/delete, public create allowed for subscribing)
    match /newsSubscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidNewsSubscriber(incoming());
      allow update: if isAdmin() && isValidId(subscriberId) && isValidNewsSubscriber(incoming());
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // News Broadcasts Collection (Admin only)
    match /newsBroadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(broadcastId) && isValidNewsBroadcast(incoming());
      allow delete: if isAdmin() && isValidId(broadcastId);
    }

    // Settings Collection (Music, Chatbot, Marquee Ticker, Mockup Version)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && (
                      (settingId == 'music' && isValidMusicSettings(incoming())) ||
                      (settingId == 'chatbot' && isValidChatbotSettings(incoming())) ||
                      (settingId == 'marqueeTicker' && isValidMarqueeTicker(incoming())) ||
                      settingId == 'mockup_version'
                    );
    }

    // Visitor Logs Collection
    match /visitorLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidId(logId) && isValidVisitorLog(incoming());
    }
  }
}
